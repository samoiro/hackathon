# 실제 비밀키를 Git에 올리지 마세요. 로컬은 이 파일을 .env로 복사해 채우고 `uvicorn --env-file .env`로 실행합니다.
AI_SERVER_PORT=8000
# OpenAI 대시보드 → API keys에서 만든 시크릿 키 (sk-...). Java 서버에는 넣지 않습니다.
LLM_API_KEY=
# 사용할 OpenAI 모델 id (GPT 6.2 Astra의 API 모델 id). 비어 있으면 /v1/analyze가 503을 돌려줍니다.
LLM_MODEL=
# Java 서버가 X-Internal-Token 헤더로 보내는 값 (server/.env의 AI_SERVER_TOKEN과 같은 값). 비어 있으면 모든 요청을 막습니다.
AI_SERVER_TOKEN=
# 선택: LLM 호출 제한 시간(초, 재요청 포함). 기본 40
LLM_TIMEOUT_SECONDS=
# 선택: temperature. 추론형 모델은 받지 않으니 지원하는 모델일 때만 0.2~0.3으로 넣습니다.
LLM_TEMPERATURE=
