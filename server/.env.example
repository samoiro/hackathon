# 이 파일을 복사해 server/.env 로 만들고 값을 채우세요. (.env는 git에 올라가지 않습니다)
# 서울 열린데이터광장 인증키: https://data.seoul.go.kr → 마이페이지 → 인증키 신청
SEOUL_API_KEY=
# 공공데이터포털 인증키(Decoding): https://www.data.go.kr → 데이터 활용신청 후 마이페이지에서 확인
DATA_GO_KR_API_KEY=
# 케이웨더 인증키: https://api.kweather.co.kr → 내 계정
KWEATHER_API_KEY=
# 카카오 디벨로퍼스 → 내 애플리케이션 → 앱 키의 "REST API 키" (좌표 → 행정동)
KAKAO_REST_API_KEY=
